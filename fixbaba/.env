# Django Settings
SECRET_KEY=django-insecure-fixbaba-dev-key-change-in-production-xyz123
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database - SQLite for development
DATABASE_URL=sqlite:///fixbaba_db.sqlite3

# Redis (optional for dev)
REDIS_URL=redis://localhost:6379/0

# Security
MAGIC_LINK_EXPIRATION_MINUTES=10080
MAGIC_LINK_MAX_ACTIVATIONS=5
DEVICE_SESSION_DAYS=90
SERVER_PEPPER=fixbaba-random-pepper-for-token-hashing-dev

# SMS Provider (example)
SMS_API_KEY=dev-sms-api-key
SMS_SENDER=FixBaba

# File Upload
MAX_UPLOAD_SIZE_MB=5
MAX_IMAGES_PER_REQUEST=5

# Storage (local for dev)
USE_S3=False

# Admin URL Prefix
ADMIN_URL_PREFIX=secure-admin
