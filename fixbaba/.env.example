# Django Settings
SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database
DATABASE_URL=postgres://user:password@localhost:5432/fixbaba_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
MAGIC_LINK_EXPIRATION_MINUTES=10080
MAGIC_LINK_MAX_ACTIVATIONS=5
DEVICE_SESSION_DAYS=90
SERVER_PEPPER=your-random-pepper-for-token-hashing

# SMS Provider (example)
SMS_API_KEY=your-sms-api-key
SMS_SENDER=FixBaba

# File Upload
MAX_UPLOAD_SIZE_MB=5
MAX_IMAGES_PER_REQUEST=5

# Storage (S3-compatible, optional)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# Admin URL Prefix
ADMIN_URL_PREFIX=secure-admin
